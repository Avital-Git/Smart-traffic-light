# Smart Traffic Controller - Production Environment Template
# Copy to .env on the target machine and adjust paths/secrets as needed.

TRAFFIC_ENV=prod
TRAFFIC_USE_SSL=true
TRAFFIC_HOST=0.0.0.0
TRAFFIC_PORT=8000

TRAFFIC_CORS_ORIGINS=https://traffic.example.com,https://admin.traffic.example.com
TRAFFIC_RATE_LIMIT_ENABLED=true
TRAFFIC_RATE_LIMIT_REQUESTS_PER_MINUTE=60
TRAFFIC_LOG_LEVEL=INFO
TRAFFIC_LOG_FILE=C:/smart_traffic/logs/server.log

TRAFFIC_SSL_CERTFILE=C:/smart_traffic/certs/server.pem
TRAFFIC_SSL_KEYFILE=C:/smart_traffic/certs/server.key
# TRAFFIC_SSL_CA_CERTS=C:/smart_traffic/certs/ca.pem

TRAFFIC_API_KEYS_FILE=C:/smart_traffic/config/api_keys.production.json
# Optional: override path if emergency keys are stored outside the repo
# TRAFFIC_EMERGENCY_KEYS_FILE=C:/smart_traffic/config/emergency_keys.json

SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=smart_traffic
# SQL_USER=
# SQL_PASSWORD=
