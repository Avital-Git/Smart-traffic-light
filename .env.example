# Smart Traffic Controller - Environment Configuration Template
# Copy this file to .env and set appropriate values for your environment

# Environment: dev, staging, or prod
TRAFFIC_ENV=dev

# Debug mode (overrides environment if set)
# DEBUG=false

# SSL/TLS Configuration
TRAFFIC_USE_SSL=false
# TRAFFIC_SSL_CERTFILE=/path/to/cert.pem
# TRAFFIC_SSL_KEYFILE=/path/to/key.pem
# TRAFFIC_SSL_CA_CERTS=/path/to/ca.pem

# CORS Configuration
# In production, specify exact origins:
# TRAFFIC_CORS_ORIGINS=https://traffic.example.com,https://admin.example.com
# In development, defaults to localhost origins
TRAFFIC_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Rate Limiting
# TRAFFIC_RATE_LIMIT_ENABLED=true
# TRAFFIC_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
TRAFFIC_LOG_LEVEL=DEBUG
# TRAFFIC_LOG_FILE=/var/log/smart_traffic.log

# API Key Authentication (for production)
# Format: "key1:secret1,key2:secret2" or point to file
# TRAFFIC_API_KEYS_FILE=/etc/smart_traffic/api_keys.json

# Database Configuration
# DATABASE_URL=mssql+pyodbc://user:password@server/database?driver=ODBC+Driver+17+for+SQL+Server

# Emergency Authentication
# Already configured via emergency_keys.json, but can override:
# TRAFFIC_EMERGENCY_KEYS_FILE=/etc/smart_traffic/emergency_keys.json

# Server Binding
# TRAFFIC_HOST=0.0.0.0
# TRAFFIC_PORT=8000
